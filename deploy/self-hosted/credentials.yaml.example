version: 1

credentials:
  dashscope-main:
    type: dashscope
    apiKey: your-key-here
    eventBridgeCallbackToken:

  deepseek-main:
    type: deepseek
    apiKey: your-key-here

  aliyun-oss-main:
    type: aliyun_oss
    accessKeyId: your-access-key-id-here
    accessKeySecret: your-access-key-secret-here
