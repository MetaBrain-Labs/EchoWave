# Copy this file to api.env before the first docker compose up.
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# PostgreSQL container. Change the password before startup.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=echowave
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=echowave
POSTGRES_SCHEMA=public
POSTGRES_SSL=false

# Reserved configuration-only integration. No Redis container is required.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false

# Generate independent random values; never publish the resulting api.env.
CREDENTIAL_MASTER_KEY=replace-with-base64-32-byte-key
CONFIGURATION_ADMIN_TOKEN=replace-with-at-least-32-random-characters
LOCAL_CREDENTIALS_FILE=.data/secrets/credentials.yaml
TRUSTED_PROXY_CIDRS=

DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
LANGGRAPH_SCHEMA=echowave_graph
UPLOAD_TEMP_DIR=.tmp/uploads
AUDIO_STORAGE_DIR=.data/audio
AUDIO_TRANSCRIPTION_TEMP_DIR=.tmp/audio-transcription
AUDIO_TRANSCRIPTION_MAX_IN_FLIGHT=1
FFMPEG_PATH=/usr/bin/ffmpeg

# Self-hosted V1 uses SSE/in-app status and does not use the official Expo push project.
PUSH_NOTIFICATIONS_ENABLED=false

AI_EXECUTION_REPORT_ENABLED=false
AI_EXECUTION_REPORT_OUTPUT_DIR=.ai-execution-reports
AI_EXECUTION_REPORT_CONTEXT_ENABLED=false
AI_EXECUTION_REPORT_TOOL_CONTENT_ENABLED=false
AI_EXECUTION_REPORT_OUTPUT_ENABLED=false
AI_EXECUTION_REPORT_REASONING_ENABLED=false
AI_EXECUTION_REPORT_STT_RAW_RESPONSE_ENABLED=false
