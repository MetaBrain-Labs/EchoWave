# Runtime configuration used by the current API.
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="meta-pm-agent"
POSTGRES_SCHEMA="public"
POSTGRES_SSL="false"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_USERNAME=""
REDIS_DB="0"
REDIS_TLS="false"

# RAG. The API reads these values only from apps/api/.env.
DEV_TENANT_ID="00000000-0000-4000-8000-000000000001"
# Required by both official DashScope embeddings and transcription.
DASHSCOPE_API_KEY="replace-me"
# Beijing workspace-dedicated DashScope native API base URL.
DASHSCOPE_BASE_URL="https://llm-your-workspace.cn-beijing.maas.aliyuncs.com/api/v1"
# Beijing workspace-dedicated OpenAI-compatible endpoint used by Qwen Omni.
DASHSCOPE_COMPATIBLE_BASE_URL="https://llm-your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
# Async task completion discovery. Use polling locally and eventbridge in production.
DASHSCOPE_ASYNC_NOTIFY_MODE="polling"
# EventBridge HTTP target. Both values must stay empty in polling mode.
DASHSCOPE_EVENTBRIDGE_CALLBACK_URL=""
DASHSCOPE_EVENTBRIDGE_CALLBACK_TOKEN=""
# Optional as a complete group. Enables Qwen Audio 3.0 speaker-turn transcription
# through a transient Beijing-region OSS staging object.
ALIYUN_OSS_REGION=""
ALIYUN_OSS_BUCKET=""
ALIYUN_OSS_ACCESS_KEY_ID=""
ALIYUN_OSS_ACCESS_KEY_SECRET=""
RAG_EMBEDDING_MODEL="qwen3.7-text-embedding"
RAG_EMBEDDING_DIMENSIONS="1024"
DEEPSEEK_API_KEY="replace-me"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_CHAT_MODEL="deepseek-v4-flash"
# Thinking mode is OFF by default; set to "true" to enable DeepSeek extended
# thinking. While enabled, DeepSeek ignores sampling parameters (temperature).
DEEPSEEK_ENABLE_THINKING="false"
LANGGRAPH_SCHEMA="echowave_graph"
UPLOAD_TEMP_DIR=".tmp/uploads"
# Persistent server directory for manually uploaded audio; mount and back it up in deployments.
AUDIO_STORAGE_DIR=".data/audio"
AUDIO_TRANSCRIPTION_MODEL="qwen-audio-3.0-asr-flash-filetrans"
AUDIO_EMOTION_MODEL="qwen3.5-omni-flash"
AUDIO_TRANSCRIPTION_TEMP_DIR=".tmp/audio-transcription"
AUDIO_TRANSCRIPTION_MAX_IN_FLIGHT="1"
# Optional. Set an absolute executable path to enable FFmpeg preprocessing.
FFMPEG_PATH=""

# Local AI execution diagnostics for controlled test environments only. Enabling
# the master switch records every model prompt and visible output after redaction
# and per-value truncation. Supplemental context, tool content, summary output,
# and hidden reasoning remain separately opt-in. Reports may contain transcripts
# and knowledge-base text; do not enable them in an uncontrolled environment.
AI_EXECUTION_REPORT_ENABLED="false"
AI_EXECUTION_REPORT_OUTPUT_DIR=".ai-execution-reports"
AI_EXECUTION_REPORT_CONTEXT_ENABLED="false"
AI_EXECUTION_REPORT_TOOL_CONTENT_ENABLED="false"
AI_EXECUTION_REPORT_OUTPUT_ENABLED="false"
AI_EXECUTION_REPORT_REASONING_ENABLED="false"
# Records DashScope submit/poll/final Qwen JSON under stt-raw.
AI_EXECUTION_REPORT_STT_RAW_RESPONSE_ENABLED="false"
