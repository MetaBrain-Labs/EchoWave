# Runtime configuration used by the current API.
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="meta-pm-agent"
POSTGRES_SCHEMA="public"
POSTGRES_SSL="false"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_USERNAME=""
REDIS_DB="0"
REDIS_TLS="false"

# Configuration security. Generate the master key as canonical Base64 for exactly 32 random bytes.
CREDENTIAL_MASTER_KEY="replace-with-base64-32-byte-key"
CONFIGURATION_ADMIN_TOKEN="replace-with-at-least-32-random-characters"
# Explicit server-local YAML path; the file may be absent until LocalCredentialProvider is used.
LOCAL_CREDENTIALS_FILE=".data/secrets/credentials.yaml"
# Comma-separated IPv4/IPv6 CIDRs allowed to assert X-Forwarded-Proto.
TRUSTED_PROXY_CIDRS=""

# Tenant and bootstrap-only runtime paths. Provider connections, models and capability bindings
# are configured in PostgreSQL through “更多 → AI 配置”.
DEV_TENANT_ID="00000000-0000-4000-8000-000000000001"
LANGGRAPH_SCHEMA="echowave_graph"
UPLOAD_TEMP_DIR=".tmp/uploads"
# Persistent server directory for manually uploaded audio; mount and back it up in deployments.
AUDIO_STORAGE_DIR=".data/audio"
AUDIO_TRANSCRIPTION_TEMP_DIR=".tmp/audio-transcription"
AUDIO_TRANSCRIPTION_MAX_IN_FLIGHT="1"
# Optional. Set an absolute executable path to enable FFmpeg preprocessing.
FFMPEG_PATH=""
# Optional. Required only when Expo Push access-token security is enabled for the project.
# EXPO_PUSH_ACCESS_TOKEN="replace-with-expo-access-token"

# Local AI execution diagnostics for controlled test environments only. Enabling
# the master switch records every model prompt and visible output after redaction
# and per-value truncation. Supplemental context, tool content, summary output,
# and hidden reasoning remain separately opt-in. Reports may contain transcripts
# and knowledge-base text; do not enable them in an uncontrolled environment.
AI_EXECUTION_REPORT_ENABLED="false"
AI_EXECUTION_REPORT_OUTPUT_DIR=".ai-execution-reports"
AI_EXECUTION_REPORT_CONTEXT_ENABLED="false"
AI_EXECUTION_REPORT_TOOL_CONTENT_ENABLED="false"
AI_EXECUTION_REPORT_OUTPUT_ENABLED="false"
AI_EXECUTION_REPORT_REASONING_ENABLED="false"
# Records DashScope submit/poll/final Qwen JSON under stt-raw.
AI_EXECUTION_REPORT_STT_RAW_RESPONSE_ENABLED="false"
