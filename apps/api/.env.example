# Runtime configuration used by the current API.
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="meta-pm-agent"
POSTGRES_SCHEMA="public"
POSTGRES_SSL="false"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_USERNAME=""
REDIS_DB="0"
REDIS_TLS="false"

# RAG. The API reads these values only from apps/api/.env.
DEV_TENANT_ID="00000000-0000-4000-8000-000000000001"
OPENROUTER_API_KEY="replace-me"
RAG_EMBEDDING_MODEL="qwen/qwen3-embedding-8b"
RAG_EMBEDDING_DIMENSIONS="1024"
DEEPSEEK_API_KEY="replace-me"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_CHAT_MODEL="deepseek-v4-flash"
# Thinking mode is OFF by default; set to "true" to enable DeepSeek extended
# thinking. While enabled, DeepSeek ignores sampling parameters (temperature).
DEEPSEEK_ENABLE_THINKING="false"
LANGGRAPH_SCHEMA="echowave_graph"
UPLOAD_TEMP_DIR=".tmp/uploads"
# Persistent server directory for manually uploaded audio; mount and back it up in deployments.
AUDIO_STORAGE_DIR=".data/audio"
AUDIO_TRANSCRIPTION_MODEL="google/gemini-2.5-flash-lite"
AUDIO_TRANSCRIPTION_TEMP_DIR=".tmp/audio-transcription"
# Optional. Set an absolute executable path to enable FFmpeg preprocessing.
FFMPEG_PATH=""

# Local AI execution diagnostics. Reports are written only after an execution
# finishes. Raw context, tool content, output, and reasoning are opt-in because
# they may contain private knowledge-base content.
AI_EXECUTION_REPORT_ENABLED="false"
AI_EXECUTION_REPORT_OUTPUT_DIR=".ai-execution-reports"
AI_EXECUTION_REPORT_CONTEXT_ENABLED="false"
AI_EXECUTION_REPORT_TOOL_CONTENT_ENABLED="false"
AI_EXECUTION_REPORT_OUTPUT_ENABLED="false"
AI_EXECUTION_REPORT_REASONING_ENABLED="false"
