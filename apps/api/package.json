{
  "name": "@echowave/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/bootstrap/server.ts",
    "lint": "eslint src test",
    "migrate": "tsx src/bootstrap/migrate.ts",
    "seed:dev": "tsx src/bootstrap/seed.ts",
    "start": "node dist/bootstrap/server.js",
    "test": "pnpm run build && node --test --test-isolation=none \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@echowave/contracts": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@langchain/core": "^1.2.8",
    "@langchain/deepseek": "^1.1.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@types/mdast": "^4.0.4",
    "ali-oss": "^6.23.0",
    "deepagents": "^1.12.4",
    "domhandler": "^6.0.1",
    "dotenv": "17.4.2",
    "exceljs": "^4.4.0",
    "hono": "4.13.2",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.1",
    "langchain": "^1.5.9",
    "mammoth": "^1.12.1",
    "mdast-util-to-string": "^4.0.0",
    "music-metadata": "^11.15.0",
    "onnxruntime-node": "1.29.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12"
  }
}
