{
  "name": "@echowave/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "cross-env EXPO_NO_TELEMETRY=1 expo start --dev-client --android",
    "build": "cross-env EXPO_NO_TELEMETRY=1 expo export --platform all --max-workers 1 --no-bytecode",
    "dev": "cross-env EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "dev:lan": "cross-env EXPO_NO_TELEMETRY=1 expo start --dev-client --lan",
    "dev:go": "cross-env EXPO_NO_TELEMETRY=1 expo start --go",
    "ios": "cross-env EXPO_NO_TELEMETRY=1 expo start --dev-client --ios",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "web": "cross-env EXPO_NO_TELEMETRY=1 expo start --web"
  },
  "dependencies": {
    "@echowave/contracts": "workspace:*",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "cross-env": "10.1.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^@expo/vector-icons/Ionicons$": "<rootDir>/src/test/IoniconsMock.tsx",
      "^expo-audio$": "<rootDir>/src/test/ExpoAudioMock.ts"
    },
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
