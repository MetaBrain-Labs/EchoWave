{
  "expo": {
    "name": "EchoWave",
    "slug": "echowave",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "echowave",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.echowave.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "EchoWave 需要连接你在本地网络中运行的自托管服务器。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.echowave.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3f03a48-c952-421c-b55d-971e509e7b30"
      }
    }
  }
}
